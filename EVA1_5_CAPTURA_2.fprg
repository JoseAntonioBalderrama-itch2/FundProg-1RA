    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Nombre" type="String" array="False" size=""/>
            <declare name="Edad" type="Integer" array="False" size=""/>
            <declare name="Salario" type="Real" array="False" size=""/>
            <output expression="&quot;Capturar el nombre:&quot;" newline="True"/>
            <input variable="Nombre"/>
            <output expression="&quot;Capturar edad:&quot;" newline="True"/>
            <input variable="Edad"/>
            <output expression="&quot;Capturar salario:&quot;" newline="True"/>
            <input variable="Salario"/>
            <output expression="&quot;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;Datos Capturados&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&quot;" newline="True"/>
            <output expression="&quot;Nombre:&quot;" newline="False"/>
            <output expression="Nombre" newline="True"/>
            <output expression="&quot;Edad:&quot;" newline="False"/>
            <output expression="Edad" newline="True"/>
            <output expression="&quot;Salario: $&quot;" newline="False"/>
            <output expression="Salario" newline="True"/>
        </body>
    </function>
</flowgorithm>
